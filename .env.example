# EVDS3 → Benim Sayfam → Profilim → "API KEY KOPYALA"
EVDS_API_KEY=
# EPİAŞ Şeffaflık Platformu kullanıcı hesabı (ücretsiz kayıt: https://kayit.epias.com.tr)
EPIAS_USERNAME=
EPIAS_PASSWORD=
# Google Trends (BigQuery public dataset): sorguların faturalanacağı Google Cloud projesi (sandbox projesi yeterli).
# Kimlik: `gcloud auth application-default login` ya da bir service account anahtar dosyası.
BQ_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/yol/service-account.json
# BQ_MAX_BYTES_BILLED=5368709120   # sorgu başına tarama tavanı (bayt), varsayılan 5 GiB
# Opsiyonel ayarlar
# MLBOOSTER_DATA_DIR=~/.mlbooster/data
# MLBOOSTER_CATALOG_DIR=/kendi/katalog/dizininiz
